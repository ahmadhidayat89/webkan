APP_NAME=KAN
# PRODUCTION: ganti ke 'production'
APP_ENV=local
# Hasilkan dengan: php artisan key:generate
APP_KEY=
# PRODUCTION: wajib false — jangan pernah true di production
APP_DEBUG=true
APP_URL=http://localhost:8000
# Timezone: Asia/Jakarta (WIB), Asia/Makassar (WITA), Asia/Jayapura (WIT)
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
# PRODUCTION: ganti ke 'error'
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
# Ganti sesuai nama database PostgreSQL Anda
DB_DATABASE=kan_db
DB_USERNAME=postgres
# JANGAN commit password asli — isi di .env lokal Anda
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Domain frontend yang diizinkan mengakses API (pisahkan koma)
# Contoh production: kan.go.id,www.kan.go.id
SANCTUM_STATEFUL_DOMAINS=localhost:5173

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@kan.go.id"
MAIL_FROM_NAME="${APP_NAME}"

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_ENABLED=false
